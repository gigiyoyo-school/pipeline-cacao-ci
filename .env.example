# Copier ce fichier en .env puis remplir les valeurs reelles.
# .env ne doit jamais etre commite : il est exclu par le .gitignore.

# --- Pipeline Python -------------------------------------------------------
# Chaine de connexion Supabase (dashboard -> Connect -> Session pooler)
SUPABASE_URL=postgresql+psycopg2://postgres.xxxxxxxxxxxx:MOT_DE_PASSE@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# --- dbt (etape 7) ---------------------------------------------------------
DBT_HOST=aws-0-eu-west-1.pooler.supabase.com
DBT_PORT=6543
DBT_USER=postgres.xxxxxxxxxxxx
DBT_PASSWORD=MOT_DE_PASSE
DBT_DBNAME=postgres
DBT_SCHEMA=public
